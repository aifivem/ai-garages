{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-garages/data/settings.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    },
    "impoundFee": {
      "description": "Fee: Paid when taking a vehicle out of the impound.",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "accounts": {
      "description": "Paid from: Money accounts tried in order.",
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 32,
        "pattern": "^[a-z0-9_]{2,32}$"
      }
    }
  },
  "required": [
    "impoundFee",
    "accounts"
  ]
}
